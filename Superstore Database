SELECT *
FROM Superstore;

--all items in descending order
SELECT *
FROM superstore
ORDER BY (price) DESC;

--all items in ascending order price
SELECT *
FROM superstore
ORDER BY (price) ASC
 

--total number of appliances
SELECT SUM (stock_quantity)
FROM superstore

--average price of all appliances
SELECT AVG (PRICE)
FROM superstore

--max price from all the appliances
SELECT MAX (price)
FROM superstore


--prices of all appliances in ascending order
SELECT *
FROM superstore
WHERE PRICE > 49.99
order BY PRICE ASC

--price total of just electronics
SELECT SUM (price)
FROM superstore
WHERE category= 'Electronics'

--prices of just kitchen supplies in descending
SELECT category, Price
FROM superstore
WHERE category='Kitchen Supplies'
ORDER BY price DESC

--stock quantity for just furnishings
SELECT item_name,category,stock_quantity
FROM superstore
where CATEGORY='Furnishings'
and STOCK_QUANTITY>0

